{
  "expo": {
    "name": "PICK Local Demo",
    "slug": "pick-local-demo",
    "version": "0.1.0",
    "scheme": "pickdemo",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PICK uses one foreground location reading when you choose arrival check-in. No background tracking."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
